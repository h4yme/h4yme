@model List<ELMIProject2.Models.ItemsModel>

@{
    ViewBag.Title = "Items";
    Layout = "~/Views/Shared/SampleView.cshtml";

    /* privileges - View Only */
    bool View = false;

    if (ViewBag.UserModulePrivileges != null && ViewBag.UserModulePrivileges.Count != 0)
    {
        foreach (var access in ViewBag.UserModulePrivileges)
        {
            View = View || access.IsView;
        }
    }
}

@if (ViewBag.UserInfo == null)
{
    <!-- No user info -->
}
else
{
    bool hasParentModule = false;
    string[] userCompanies = ((string)ViewBag.UserInfo[0].Company).Split('/');

    foreach (var account in ViewBag.UserInfo)
    {
        if (account.Module == "Items" && account.IsView == true || account.UserType != "0")
        {
            hasParentModule = true;
            break;
        }
    }

    if (!hasParentModule)
    {
        <script>
            error404Show();
        </script>
    }
    else
    {
        <div class="upper-container">
            <div class="button-container d-block d-md-flex">
                <button class="backBtn" onclick="window.location.href='/Inventory/Dashboard';">
                    <svg height="16" width="16" xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 1024 1024">
                        <path d="M874.690416 495.52477c0 11.2973-9.168824 20.466124-20.466124 20.466124l-604.773963 0 188.083679 188.083679c7.992021 7.992021 7.992021 20.947078 0 28.939099-4.001127 3.990894-9.240455 5.996574-14.46955 5.996574-5.239328 0-10.478655-1.995447-14.479783-5.996574l-223.00912-223.00912c-3.837398-3.837398-5.996574-9.046027-5.996574-14.46955 0-5.433756 2.159176-10.632151 5.996574-14.46955l223.019353-223.029586c7.992021-7.992021 20.957311-7.992021 28.949332 0 7.992021 8.002254 7.992021 20.957311 0 28.949332l-188.073446 188.073446 604.753497 0C865.521592 475.058646 874.690416 484.217237 874.690416 495.52477z"></path>
                    </svg>
                    <span>Back</span>
                </button>
            </div>
        </div>

        <script>
            // User privileges - View Only
            const canView = @View.ToString().ToLower();
            const loggedInUser = '@((ViewBag.UserInfo as List<ELMIProject2.Models.LoginModel>)?[0]?.UserName ?? "unknown")';
        </script>

        <div class="main-container">
            <div class="grid-container">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-offset-8 col-md-4">
                            <div class="form">
                                <button id="searchBtn">
                                    <svg width="17" height="16" fill="none" xmlns="http://www.w3.org/2000/svg" role="img">
                                        <path d="M7.667 12.667A5.333 5.333 0 107.667 2a5.333 5.333 0 000 10.667zM14.334 14l-2.9-2.9" stroke="currentColor" stroke-width="1.333" stroke-linecap="round" stroke-linejoin="round"></path>
                                    </svg>
                                </button>
                                <input class="input" id="itemSearch" placeholder="Search Item Description..." type="text" autocomplete="off" onkeyup="searchBox()">
                                <button id="resetSearch" onclick="resetSearch()">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="list-container">
                    <table class="table table-striped table-bordered" id="tbl_items">
                        <thead>
                            <tr>
                                <th>ItemID</th>
                                <th>ItemDescription</th>
                                <th>Brand</th>
                                <th>Created On</th>
                                <th>Created By</th>
                                <th>Active</th>
                            </tr>
                        </thead>
                        <tbody id="itemsBody">
                            @foreach (var item in Model)
                            {
                                <tr data-recid="@item.RecID"
                                    data-itemid="@item.ItemID"
                                    data-itemdesc="@item.ItemDescription"
                                    data-brand="@item.Brand"
                                    data-active="@item.Active"
                                    class="view-only-row">
                                    <td>@item.ItemID</td>
                                    <td>@item.ItemDescription</td>
                                    <td>@item.Brand</td>
                                    <td>@item.CreatedDate</td>
                                    <td>@item.CreatedBy</td>
                                    <td>@item.Active</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div id="loading" style="display: none;">Loading...</div>
                </div>
            </div>
        </div>

        <!-- View Details Modal (Read-Only) -->
        <div id="viewBoxModal" class="modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h2>Item Details</h2>
                    <span class="close" onclick="closeViewBoxModal()">&times;</span>
                </div>
                <div class="modal-body">
                    <div class="detail-group">
                        <label>Item ID:</label>
                        <div class="detail-value" id="viewItemId">-</div>
                    </div>
                    <div class="detail-group">
                        <label>Item Description:</label>
                        <div class="detail-value" id="viewItemDesc">-</div>
                    </div>
                    <div class="detail-group">
                        <label>Brand:</label>
                        <div class="detail-value" id="viewBrand">-</div>
                    </div>
                    <div class="detail-group">
                        <label>Active Status:</label>
                        <div class="detail-value" id="viewActive">-</div>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn-close-modal" onclick="closeViewBoxModal()">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

<link rel="stylesheet" type="text/css" href="~/Content/masterfiles.css" />

<style>
    table, th, td {
        border: none;
        text-align: center;
    }

    tbody tr.view-only-row:hover {
        cursor: pointer;
        background-color: #e8f4f8;
    }

    thead tr:hover {
        cursor: default;
        background-color: none;
    }

    thead {
        position: sticky;
        top: 0;
        background: #192637;
        color: #fff;
    }

    table {
        border-radius: 4px;
    }

    .button-container {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Modal Styles */
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        overflow: auto;
        background-color: rgba(0,0,0,0.5);
        animation: fadeIn 0.3s;
    }

    .modal-content {
        background-color: #fefefe;
        margin: 5% auto;
        border-radius: 8px;
        width: 90%;
        max-width: 600px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        animation: slideIn 0.3s;
    }

    .modal-header {
        padding: 20px;
        background-color: #192637;
        color: white;
        border-radius: 8px 8px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .modal-header h2 {
            margin: 0;
            font-size: 20px;
        }

    .close {
        color: white;
        font-size: 28px;
        font-weight: bold;
        cursor: pointer;
        transition: color 0.3s;
    }

        .close:hover {
            color: #ccc;
        }

    .modal-body {
        padding: 30px;
    }

    .detail-group {
        margin-bottom: 20px;
        border-bottom: 1px solid #e9ecef;
        padding-bottom: 15px;
    }

        .detail-group:last-of-type {
            border-bottom: none;
        }

        .detail-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #6c757d;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .detail-group .detail-value {
            font-size: 16px;
            color: #333;
            font-weight: 500;
            padding: 8px 0;
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 30px;
    }

    .btn-close-modal {
        padding: 10px 24px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.3s;
        background-color: #6c757d;
        color: white;
    }

        .btn-close-modal:hover {
            background-color: #5a6268;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes slideIn {
        from {
            transform: translateY(-50px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
</style>

<script>
    let offset = 0;
    const pageSize = 1000;
    let loading = false;
    let allDataLoaded = false;

    function attachRowClickHandlers() {
        $('#itemsBody tr.view-only-row').off('click').on('click', function () {
            const itemID = $(this).data('itemid');
            const itemDesc = $(this).data('itemdesc');
            const brand = $(this).data('brand');
            const active = $(this).data('active');

            openViewBoxModal(itemID, itemDesc, brand, active);
        });
    }

    $(document).ready(function () {

        function loadItems(searchTerm) {
            if (loading) return;
            loading = true;
            allDataLoaded = false;
            $('#loading').show();

            $.ajax({
                url: '/Inventory/LoadItems',
                data: { offset: 0, pageSize: pageSize, searchTerm: searchTerm },
                success: function (data) {
                    $('#itemsBody').html(data);
                    offset = pageSize;
                    $('.list-container').on('scroll', onScrollLoadMore);

                    // Add click handlers to rows
                    attachRowClickHandlers();
                },
                complete: function () {
                    loading = false;
                    $('#loading').hide();
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to load items.',
                        confirmButtonColor: '#192637'
                    });
                }
            });
        }

        function loadMoreItems(searchTerm) {
            if (loading || allDataLoaded) return;
            loading = true;
            $('#loading').show();

            $.ajax({
                url: '/Inventory/LoadItems',
                data: { offset: offset, pageSize: pageSize, searchTerm: searchTerm },
                success: function (data) {
                    if ($.trim(data).length === 0) {
                        allDataLoaded = true;
                        $('.list-container').off('scroll', onScrollLoadMore);
                    } else {
                        $('#itemsBody').append(data);
                        offset += pageSize;

                        // Add click handlers to new rows
                        attachRowClickHandlers();
                    }
                },
                complete: function () {
                    loading = false;
                    $('#loading').hide();
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to load more items.',
                        confirmButtonColor: '#192637'
                    });
                }
            });
        }

        function onScrollLoadMore() {
            var container = $('.list-container');
            if (container.scrollTop() + container.innerHeight() >= container[0].scrollHeight - 200) {
                loadMoreItems($('#itemSearch').val());
            }
        }

        // Initial load
        loadItems('');

        window.searchBox = function () {
            var input = document.getElementById("itemSearch");
            var filter = (input.value || "").toUpperCase();
            var tbody = document.getElementById("itemsBody");
            if (!tbody) return;

            var rows = tbody.getElementsByTagName("tr");
            var colIndex = 1;

            for (var i = 0; i < rows.length; i++) {
                var cell = rows[i].getElementsByTagName("td")[colIndex];
                var text = cell ? (cell.textContent || cell.innerText) : "";
                rows[i].style.display = text.toUpperCase().indexOf(filter) > -1 ? "" : "none";
            }
        };
    });

    function openViewBoxModal(itemID, itemDesc, brand, active) {
        // Check if user has View privilege
        if (!canView) {
            Swal.fire({
                icon: 'warning',
                title: 'Access Denied',
                text: 'You do not have permission to view item details.',
                confirmButtonColor: '#192637'
            });
            return;
        }

        document.getElementById('viewBoxModal').style.display = 'block';
        $('#viewItemId').text(itemID || '-');
        $('#viewItemDesc').text(itemDesc || '-');
        $('#viewBrand').text(brand || '-');

        const activeStatus = (active === 'Yes' || active === '1' || active === 1) ? 'Active' : 'Inactive';
        $('#viewActive').text(activeStatus);
    }

    function closeViewBoxModal() {
        document.getElementById('viewBoxModal').style.display = 'none';
    }

    function resetSearch() {
        $('#itemSearch').val('');
        searchBox();

        // Optional: Show toast notification
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 2000,
            timerProgressBar: true,
        });

        Toast.fire({
            icon: 'info',
            title: 'Search cleared'
        });
    }

    // Close modal when clicking outside
    window.onclick = function (event) {
        const viewModal = document.getElementById('viewBoxModal');

        if (event.target == viewModal) {
            closeViewBoxModal();
        }
    }

    // ESC key to close modals
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            const viewModalOpen = document.getElementById('viewBoxModal').style.display === 'block';

            if (viewModalOpen) {
                closeViewBoxModal();
            }
        }
    });
</script>
